{
  "recipe": "ishan",
  "episodes": 3000,
  "seed": 1,
  "hidden": 256,
  "batch_episodes": 4,
  "loss_divisor": "episodes",
  "reset_at_points": true,
  "max_grad_norm": null,
  "chunk_size": 0,
  "eval_episodes": 500,
  "gamma": 0.99,
  "learning_rate": 0.001,
  "outer_time_discount": false,
  "reference": "https://github.com/ishan-monie/advanced-ml-hw1",
  "estimator": "discounted reward-to-go without outer gamma^t; point-segmented for ishan",
  "baseline": "none",
  "return_standardization": false,
  "entropy_coefficient": 0.0,
  "environment": "ALE/Pong-v5",
  "frameskip": 4,
  "sticky_action_probability": 0.25,
  "policy_actions": [
    2,
    3
  ],
  "startup_fire": false,
  "initial_frame": "zeros",
  "sampling": "torch_distribution",
  "state_storage": "int8; exact for binary frame differences",
  "resume_note": "Snapshots are for inspection; no exact resume is implemented."
}
